# Frontend environment variables — copy to .env and customise locally
# .env is gitignored; only this file (.env.example) is committed.

# Backend API base URL.
# Local dev: leave as http://localhost:8000 (Vite dev server proxies are not needed).
# Droplet / CI: set to the public backend URL before building the SPA image.
#   e.g. VITE_API_BASE_URL=https://bd26-t2c.thatbackendguy.com
VITE_API_BASE_URL=http://localhost:8000

# Shared token for POST /config writes (ADR-013).
# Must match CONFIG_WRITE_TOKEN set on the backend. Blank = gate off (local dev).
# On the droplet, set this to the same token configured in the backend .env.
VITE_CONFIG_WRITE_TOKEN=