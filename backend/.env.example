# ── Kafka ───────────────────────────────────────────────────────────────────
# Comma-separated list of broker addresses (host:port)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Topic names — must match values used by M1 (producer) and M2/M3 (Flink)
KAFKA_TOPIC_RAW=radiation.raw
KAFKA_TOPIC_CLEAN=radiation.clean
KAFKA_TOPIC_AGGREGATED=radiation.aggregated
KAFKA_TOPIC_ALERTS=radiation.alerts
KAFKA_TOPIC_CONFIG=config.updates

# ── Kafka topic creation (admin client, run on backend startup) ─────────────
# Partitions/replication for topics the backend creates idempotently.
# Replication factor must be 1 for a single-broker (KRaft) dev cluster.
KAFKA_NUM_PARTITIONS=1
KAFKA_REPLICATION_FACTOR=1
# Set false to skip topic creation (e.g. when topics are managed externally)
KAFKA_TOPIC_INIT_ENABLED=true
# Retry policy while waiting for the broker to become reachable on startup
KAFKA_ADMIN_RETRY_ATTEMPTS=10
KAFKA_ADMIN_RETRY_BACKOFF_SECONDS=3.0

# ── Kafka consumer (radiation.clean + radiation.alerts) ─────────────────────
# Clean events feed the ring buffer and fan out to WebSocket clients; alerts
# fan out only.
KAFKA_CONSUMER_GROUP_ID=backend-consumer
# Set false to disable the background consumer (e.g. in tests)
KAFKA_CONSUMER_ENABLED=true

# ── Kafka producer (config.updates) ─────────────────────────────────────────
# POST /config publishes user filter settings to config.updates, which
# Flink (M2/M3) consumes as broadcast state. When the broker is unreachable the
# endpoint fails with 503 (strict) rather than silently diverging from Flink.
# Set false to disable the producer (e.g. in tests).
KAFKA_PRODUCER_ENABLED=true
KAFKA_PRODUCER_CLIENT_ID=backend-config-producer

# ── WebSocket /ws/stream ────────────────────────────────────────────────────
# Backpressure-aware fan-out. Clean/aggregated state coalesces latest-wins per
# key for slow clients; alerts queue FIFO. This caps the per-client FIFO lane
# (alerts) as a last-resort safety valve so memory stays bounded.
BROADCASTER_QUEUE_MAXSIZE=100
# Per-client cap on the coalescing lane, in distinct keys (sensors / geo buckets).
# Bounds a stalled client's memory to one entry per key up to this ceiling; past
# it the least-recently-updated key's pending state is evicted (re-sent on its next
# update). Generous — only a pathological cardinality explosion should reach it.
BROADCASTER_COALESCED_MAXSIZE=5000
# Throttle window (ms): a slow client is flushed at most once per interval, so
# coalescing accumulates within each window and send cadence stays bounded.
BROADCASTER_FLUSH_INTERVAL_MS=100

# ── Ring buffer / /recent endpoint ──────────────────────────────────────────
# Number of most-recent clean events kept in memory for GET /recent
RECENT_BUFFER_SIZE=500
# Default and maximum values for the ?limit query parameter. Pagination uses an
# opaque ?cursor returned as next_cursor; paging is bounded to this window.
RECENT_DEFAULT_LIMIT=50
RECENT_MAX_LIMIT=500

# ── Radiation thresholds (CPM — counts per minute) ──────────────────────────
# Events below warn threshold are classified SAFE
CPM_WARN_THRESHOLD=100
# Events above danger threshold are classified DANGER; between is WARN
CPM_DANGER_THRESHOLD=1000

# ── Service ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# GET /metrics (Prometheus text, namespace `backend`) is always on — no toggle.
# GET /health always answers HTTP 200 while serving; degraded Kafka components
# are reported in the body (the compose service_healthy gate depends on the 200).

# CORS origins — comma-separated. Use * for local dev; restrict in production.
# Doubles as the allowlist for the /ws/stream WebSocket origin check.
CORS_ORIGINS=*
