  "components": {
    "schemas": {
      "AreaFilter": {
        "properties": {
          "min_lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Min Lat",
            "examples": [
              34.0
            ]
          },
          "max_lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Max Lat",
            "examples": [
              38.5
            ]
          },
          "min_lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Min Lon",
            "examples": [
              138.0
            ]
          },
          "max_lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Max Lon",
            "examples": [
              142.0
            ]
          }
        },
        "type": "object",
        "required": [
          "min_lat",
          "max_lat",
          "min_lon",
          "max_lon"
        ],
        "title": "AreaFilter"
      },
      "ConfigPayload": {
        "properties": {
          "cpm_warn_threshold": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cpm Warn Threshold",
            "examples": [
              100.0
            ]
          },
          "cpm_danger_threshold": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cpm Danger Threshold",
            "examples": [
              1000.0
            ]
          },
          "area": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AreaFilter"
              },
              {
                "type": "null"
              }
            ]
          },
          "timespan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TimespanFilter-Input"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "ConfigPayload",
        "description": "Partial update \u2014 omitted fields keep their current value."
      },
      "ConfigResponse": {
        "properties": {
          "cpm_warn_threshold": {
            "type": "number",
            "title": "Cpm Warn Threshold"
          },
          "cpm_danger_threshold": {
            "type": "number",
            "title": "Cpm Danger Threshold"
          },
          "area": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AreaFilter"
              },
              {
                "type": "null"
              }
            ]
          },
          "timespan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TimespanFilter-Output"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "cpm_warn_threshold",
          "cpm_danger_threshold"
        ],
        "title": "ConfigResponse"
      },
      "ConfigUpdateResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "config": {
            "$ref": "#/components/schemas/ConfigResponse"
          }
        },
        "type": "object",
        "required": [
          "status",
          "config"
        ],
        "title": "ConfigUpdateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
