# Data Provider
CSV_FILE=./data/sample.csv      # set to ./measurements-out.csv to use the full dataset
PRODUCER_SPEED=1x               # replay speed: <N> ev/s, <N>x multiplier (10x, 500), or 'max' (unthrottled)
BACKFILL_START=                 # ISO8601 lower bound on captured_at (e.g. 2011-03-11T00:00:00); empty = no lower bound
BACKFILL_END=                   # ISO8601 upper bound on captured_at (e.g. 2011-04-30T23:59:59); empty = no upper bound
BACKFILL_PRESET=                # named event window (e.g. fukushima); sets BACKFILL_START/END if not already set

# Data Provider — Kafka producer throughput tuning (defaults from ADR-012 / load test).
KAFKA_BATCH_SIZE=65536          # producer batch.size in bytes (NOT the CSV sort batch)
KAFKA_LINGER_MS=20              # producer linger.ms — wait to fill a batch before sending
KAFKA_COMPRESSION_TYPE=lz4      # lz4 | gzip | snappy | zstd | none

# Kafka (shared)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=radiation.raw

# Postgres — historical archive of radiation.aggregated blobs (ADR-018).
POSTGRES_DB=radiation
POSTGRES_USER=radiation
POSTGRES_PASSWORD=radiation      # DEV DEFAULT — set a strong value in the droplet .env
POSTGRES_HOST_PORT=5433          # host-published port (container is 5432; 5433 avoids a local PG clash)
POSTGRES_MEM_LIMIT=384m          # Postgres container memory ceiling
# aggregated-sink (Kafka radiation.aggregated → Postgres) tuning.
AGG_SINK_BATCH_SIZE=200          # rows per upsert batch
AGG_SINK_MEM_LIMIT=192m          # sink container memory ceiling

# --- DigitalOcean droplet deploy (docker-compose.prod.yml — leave defaults for local dev) ---
# Public origin the SPA is served from AND Caddy's site address. Baked into the frontend
# build and reused as CORS_ORIGINS (below). Use the https domain on the droplet:
#   https://bd26-t2c.thatbackendguy.com → Caddy auto-fetches a Let's Encrypt cert; WS becomes wss://
#   http://<droplet-ip>             → plain HTTP fallback (no cert; a bare IP can't get one)
#   http://localhost                → LOCAL prod-parity run: browser + Caddy on this machine.
#     With the droplet domain here, a locally-built frontend calls the droplet, not your
#     local stack ("Reconnecting…", empty map). Open http://localhost (the proxy), not :5173.
PUBLIC_URL=https://bd26-t2c.thatbackendguy.com
# Interface the BASE compose publishes its ports on. Local dev: 0.0.0.0 (reachable).
# Droplet: 127.0.0.1 so kafka 29092 / flink UI 8081 / metrics 8001 / backend 8000 /
# frontend 5173 bind loopback-only and ONLY the reverse proxy (below) is public.
BIND_HOST=0.0.0.0
HTTP_PORT=80                    # ACME HTTP challenge + 80→443 redirect
HTTPS_PORT=443                  # public HTTPS
PROXY_MEM_LIMIT=128m            # reverse-proxy (Caddy) container memory ceiling

# Frontend (base compose only — the prod override bakes PUBLIC_URL instead).
# API origin the SPA calls; blank = http://localhost:8000 fallback baked into the
# bundle (fine when the browser runs on this machine). Set to http://<this-host>:8000
# when testing from another device on the LAN. Build-time: rebuild after changing.
VITE_API_BASE_URL=

# Backend (FastAPI)
# Comma-separated CORS + /ws/stream origin allowlist. `*` is for local dev only.
# Droplet .env: set to the origin the frontend is SERVED FROM — scheme + host,
# port only if non-standard. E.g. CORS_ORIGINS=http://203.0.113.10 (plain-IP
# deploy behind the reverse proxy on port 80) or https://radiation.example.com
# once a domain + TLS exist. See docs/security-review-backend.md §4.
CORS_ORIGINS=*
CONFIG_WRITE_TOKEN=             # shared secret required on POST /config (X-Config-Token header); blank = gate off (local). Set on the droplet.
BACKEND_MEM_LIMIT=512m          # backend container memory ceiling in docker-compose

# Kafka cloud security (optional — leave blank/unset for the local plaintext broker).
# Set these to connect the Flink job, producer, backend and scripts/provision_topics.py to
# a managed broker (Confluent Cloud / Redpanda Serverless) over SASL_SSL. See docs/cloud/kafka.md.
# NEVER commit real credentials — .env is gitignored; only .env.example (placeholders) is tracked.
KAFKA_SECURITY_PROTOCOL=        # e.g. SASL_SSL (blank/PLAINTEXT = local, no security)
KAFKA_SASL_MECHANISM=           # e.g. PLAIN (Confluent/Redpanda API key) or SCRAM-SHA-256
KAFKA_SASL_USERNAME=            # cloud API key / username  (placeholder — set in your local .env)
KAFKA_SASL_PASSWORD=            # cloud API secret / password (placeholder — set in your local .env)
KAFKA_NUM_PARTITIONS=1          # partitions per topic when provisioning (raise for cloud throughput)
KAFKA_REPLICATION_FACTOR=1      # replication factor when provisioning (3 on a multi-broker cloud)

# Flink — geo aggregation & rolling-stats operators (all optional; defaults shown)
FLINK_AGG_WINDOW_SECONDS=60      # tumbling event-time window length for geo aggregation
FLINK_ROLLING_WINDOWS=6          # windows of cpm_avg forming the per-geohash rolling baseline
FLINK_ZSCORE_THRESHOLD=3.0       # |z-score| at/above which a cell/window is flagged anomaly

# Flink — DO droplet resource caps (8 GB RAM; defaults leave headroom for Kafka + backend)
FLINK_JM_MEM_LIMIT=1280m         # JobManager container memory ceiling
FLINK_JM_PROCESS_SIZE=1024m      # JobManager total Flink process memory
FLINK_TM_MEM_LIMIT=2560m         # TaskManager container memory ceiling (holds keyed state)
FLINK_TM_PROCESS_SIZE=2048m      # TaskManager total Flink process memory

# Flink — checkpointing (local leaves these unset → 60s interval, in-memory JM storage)
FLINK_CHECKPOINT_INTERVAL_MS=60000   # checkpoint interval in ms
FLINK_CHECKPOINT_MIN_PAUSE_MS=5000   # min pause between checkpoints in ms
FLINK_CHECKPOINT_TIMEOUT_MS=600000   # checkpoint timeout in ms
# durable checkpoint storage URI; on the droplet set file:///opt/flink/state/checkpoints; empty = local in-memory
FLINK_CHECKPOINT_DIR=
# 'rocksdb' for large keyed state on the droplet; empty = in-heap hashmap
FLINK_STATE_BACKEND=
# savepoint URI; defaults to file:///opt/flink/state/savepoints (shared flink-state volume)
FLINK_SAVEPOINT_DIR=
